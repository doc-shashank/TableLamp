<Window
    x:Class="TableLamp.Views.TableLampLauncher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TableLamp.Views"
    mc:Ignorable="d"
    Title="Table Lamp">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Subtle Ambient Glow -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.2" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#220078D7" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Custom Title Bar Caption Controls (Settings, Minimize & Exit) -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,10,0" Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="LauncherSettingsButton"
                        AutomationProperties.AutomationId="Launcher_SettingsButton"
                        ToolTipService.ToolTip="Launcher Settings"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="44"
                        Height="32"
                        Padding="0">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="WindowMinimizeButton"
                        AutomationProperties.AutomationId="Launcher_MinimizeButton"
                        ToolTipService.ToolTip="Minimize"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="44"
                        Height="32"
                        Padding="0">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="WindowExitButton"
                        AutomationProperties.AutomationId="Launcher_ExitButton"
                        ToolTipService.ToolTip="Close"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="44"
                        Height="32"
                        Padding="0">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area: Mode Selection View -->
        <Grid x:Name="LauncherModesContainer" RowDefinitions="Auto,*,Auto,Auto" Margin="32,20,32,18" VerticalAlignment="Center">
            <!-- Launcher Header (Version badge moved to bottom) -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE781;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Table Lamp" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Select a mode to launch your study workspace"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Three Card Containers Placed Horizontally -->
            <Grid Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ColumnSpacing="18"
                  Margin="0,18,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="165" />
                </Grid.ColumnDefinitions>

                <!-- Card Container 1: Basic (Interactive Button) -->
                <Border x:Name="BasicCard"
                        Grid.Column="0"
                        Height="160"
                        CornerRadius="14"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="0"
                        IsHitTestVisible="True">
                    <Button x:Name="BasicCardButton"
                            AutomationProperties.AutomationId="Launcher_BasicCard"
                            AutomationProperties.Name="Launch Basic Mode"
                            Click="OnBasicCardButtonClicked"
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="14"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="24"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="BasicText"
                                       Grid.Row="1"
                                       Text="Basic"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2" />
                        </Grid>
                    </Button>
                </Border>

                <!-- Card Container 2: Advanced (Not Interactable for now) -->
                <Border x:Name="AdvancedCard"
                        Grid.Column="1"
                        Height="160"
                        CornerRadius="14"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Opacity="0.5"
                        Padding="14"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <TextBlock x:Name="AdvancedText"
                                   AutomationProperties.AutomationId="Launcher_AdvancedCard"
                                   Grid.Row="1"
                                   Text="Advanced"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,2" />
                    </Grid>
                </Border>

                <!-- Card Container 3: Generator (Interactive Button) -->
                <Border x:Name="GeneratorCard"
                        Grid.Column="2"
                        Height="160"
                        CornerRadius="14"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="0"
                        IsHitTestVisible="True">
                    <Button x:Name="GeneratorCardButton"
                            AutomationProperties.AutomationId="Launcher_GeneratorCard"
                            AutomationProperties.Name="Launch Generator Mode"
                            Click="OnGeneratorCardButtonClicked"
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="14"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="24"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="GeneratorText"
                                       Grid.Row="1"
                                       Text="Generator"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2" />
                        </Grid>
                    </Button>
                </Border>

                <!-- Card Container 4: Library (Interactive Button) -->
                <Border x:Name="LibraryCard"
                        Grid.Column="3"
                        Height="160"
                        CornerRadius="14"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="0"
                        IsHitTestVisible="True">
                    <Button x:Name="LibraryCardButton"
                            AutomationProperties.AutomationId="Launcher_LibraryCard"
                            AutomationProperties.Name="Launch Library Mode"
                            Click="OnLibraryCardButtonClicked"
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Padding="14"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="24"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE8F1;" FontSize="20" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="LibraryText"
                                       Grid.Row="1"
                                       Text="Library"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2" />
                        </Grid>
                    </Button>
                </Border>
            </Grid>

            <!-- Update Notification Labels (Curated Tags) below cards, above version label -->
            <StackPanel Grid.Row="2"
                        x:Name="UpdateLabelsPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4"
                        Margin="0,0,0,10">
                <!-- Curated Tags Update Notification Label -->
                <Button x:Name="CuratedUpdateNotificationBtn"
                        Visibility="Collapsed"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="CuratedUpdateNotificationText"
                                   Text="Curated Tags Update Available"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Launcher Footer with Version Label at Bottom of Screen -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Table Lamp" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="LauncherVersionTextBlock"
                               AutomationProperties.AutomationId="Launcher_VersionText"
                               Text="Version 0.0.8.2"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Button x:Name="DevToolsButton"
                        AutomationProperties.AutomationId="Launcher_DevToolsButton"
                        Grid.Column="1"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="12,6"
                        ToolTipService.ToolTip="Open Developer Tools &amp; Custom Presets Editor">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE90F;" FontSize="13" />
                        <TextBlock Text="Dev Tools" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- In-Window Launcher Settings Presenter -->
        <ContentControl x:Name="LauncherSettingsPresenter"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Margin="0,38,0,0"
                        Canvas.ZIndex="50" />

        <!-- Floating Notification Card floating below App Name header on Left -->
        <local:FloatingNotificationCard x:Name="NotificationCard"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="24,84,0,0"
                                        Canvas.ZIndex="1000" />
    </Grid>
</Window>
