<Window
    x:Class="TableLamp.Views.TableLampLauncher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TableLamp.Views"
    mc:Ignorable="d"
    Title="Table Lamp">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Subtle Ambient Glow -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.2" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#220078D7" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Custom Title Bar Caption Controls (Settings, Minimize & Exit) -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,10,0" Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="LauncherSettingsButton"
                        ToolTipService.ToolTip="Launcher Settings"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="44"
                        Height="32"
                        Padding="0">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="WindowMinimizeButton"
                        ToolTipService.ToolTip="Minimize"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="44"
                        Height="32"
                        Padding="0">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="WindowExitButton"
                        ToolTipService.ToolTip="Close"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Width="44"
                        Height="32"
                        Padding="0">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area: Mode Selection View -->
        <Grid x:Name="LauncherModesContainer" RowDefinitions="Auto,*,Auto" Margin="32,20,32,18" VerticalAlignment="Center">
            <!-- Launcher Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE781;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Table Lamp" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                            CornerRadius="6" 
                            Padding="7,2" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.0.7.0" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Select a mode to launch your study workspace"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Three Card Containers Placed Horizontally -->
            <Grid Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ColumnSpacing="18"
                  Margin="0,20,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <!-- Card Container 1: Basic (Interactive Button) -->
                <Border x:Name="BasicCard"
                        Grid.Column="0"
                        Height="160"
                        CornerRadius="14"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="14"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="BasicText"
                                   Grid.Row="1"
                                   Text="Basic"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,2" />
                    </Grid>
                </Border>

                <!-- Card Container 2: Advanced (Not Interactable for now) -->
                <Border x:Name="AdvancedCard"
                        Grid.Column="1"
                        Height="160"
                        CornerRadius="14"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Opacity="0.5"
                        Padding="14"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <TextBlock x:Name="AdvancedText"
                                   Grid.Row="1"
                                   Text="Advanced"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,2" />
                    </Grid>
                </Border>

                <!-- Card Container 3: Generator (Not Interactable for now) -->
                <Border x:Name="GeneratorCard"
                        Grid.Column="2"
                        Height="160"
                        CornerRadius="14"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Opacity="0.5"
                        Padding="14"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="48"
                                Height="48"
                                CornerRadius="24"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <TextBlock x:Name="GeneratorText"
                                   Grid.Row="1"
                                   Text="Generator"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,2" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Launcher Footer with Dev Tools Button -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Table Lamp" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Version 0.0.7.0" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <Button x:Name="DevToolsButton"
                        Grid.Column="1"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="12,6"
                        ToolTipService.ToolTip="Open Developer Tools &amp; Custom Presets Editor">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE90F;" FontSize="13" />
                        <TextBlock Text="Dev Tools" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- In-Window Launcher Settings Container -->
        <Frame x:Name="LauncherSettingsFrame"
               Visibility="Collapsed"
               Margin="0,38,0,0"
               Canvas.ZIndex="50" />

        <!-- Floating Notification Card floating below App Name header on Left -->
        <local:FloatingNotificationCard x:Name="NotificationCard"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="24,84,0,0"
                                        Canvas.ZIndex="1000" />
    </Grid>
</Window>
