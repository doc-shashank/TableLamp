<Page
    x:Class="TableLamp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TableLamp.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="32" Margin="32,36,32,48">
            <!-- Welcome Header -->
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="Table Lamp Workspace"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Plan, create, and review your study sessions"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Two Centralized CardButtons -->
            <Grid ColumnSpacing="24" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- CardButton 1: Create a New Session -->
                <Border x:Name="CreateSessionCardButton"
                        Grid.Column="0"
                        Height="180"
                        CornerRadius="16"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="24"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0"
                                Width="48"
                                Height="48"
                                CornerRadius="12"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="Create a New Session"
                                       FontSize="19"
                                       FontWeight="Bold" />
                            <TextBlock Text="Configure subject, chapter, and author question cards"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="Get Started" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CardButton 2: Review Session -->
                <Border x:Name="ReviewSessionCardButton"
                        Grid.Column="1"
                        Height="180"
                        CornerRadius="16"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="24"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0"
                                Width="48"
                                Height="48"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="Review Session"
                                       FontSize="19"
                                       FontWeight="Bold" />
                            <TextBlock Text="Practice and test active recall across your prepared questions"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="Browse Sessions" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Section Below: Recent Sessions -->
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Recent Sessions" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <Button x:Name="ViewAllSessionsButton"
                            Grid.Column="1"
                            Content="View All Sessions"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="12,6" />
                </Grid>

                <!-- Recent Sessions ItemsControl -->
                <ItemsControl x:Name="RecentSessionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18,14"
                                    Tapped="OnRecentSessionTapped"
                                    Tag="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Session Details -->
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding FormattedDate}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding QuestionCount}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="question(s)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Arrow Icon -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Open" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
