<Page
    x:Class="TableLamp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TableLamp.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <!-- 2-Column Dashboard: Left: Recent Sessions, Right: Action Buttons in their place -->
        <Grid ColumnDefinitions="360,*" ColumnSpacing="36" Margin="36,32,36,48" MaxWidth="1180" HorizontalAlignment="Center">
            <!-- 1. Left Column: Recent Sessions Section -->
            <StackPanel Grid.Column="0" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Recent Sessions" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <Button x:Name="ViewAllSessionsButton"
                            Grid.Column="1"
                            Content="View All"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="10,4"
                            FontSize="12" />
                </Grid>

                <!-- Recent Sessions ItemsControl -->
                <ItemsControl x:Name="RecentSessionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Tapped="OnRecentSessionTapped"
                                    Tag="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Session Details -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding QuestionCount}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="q" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Arrow Icon -->
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 2. Right Column: New Session & Review Session Buttons (Maintained in their place) -->
            <Grid Grid.Column="1" ColumnSpacing="24" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- CardButton 1: Create a New Session (Extends vertically downwards upon click) -->
                <Border x:Name="CreateSessionCardButton"
                        Grid.Column="0"
                        Height="250"
                        CornerRadius="16"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="24"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                        <Border Grid.Row="0"
                                Width="54"
                                Height="54"
                                CornerRadius="14"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE710;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center" Margin="0,14,0,10">
                            <TextBlock Text="Create a New Session"
                                       FontSize="21"
                                       FontWeight="Bold" />
                            <TextBlock Text="Configure subject, chapter, and author question cards with active recall tags"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Get Started Indicator (Collapsed when extended) -->
                        <StackPanel x:Name="GetStartedIndicator" Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="Get Started" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Extension Options: Curated and Custom separated by a separator -->
                        <StackPanel x:Name="CreateSessionOptionsPanel"
                                    Grid.Row="3"
                                    Visibility="Collapsed"
                                    Opacity="0"
                                    Margin="0,10,0,0">
                            <!-- Separator line -->
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,12" />

                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                <!-- Curated Option -->
                                <Button x:Name="CuratedOptionButton"
                                        Grid.Column="0"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,8"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE735;" FontSize="12" />
                                        <TextBlock Text="Curated" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                </Button>

                                <!-- Vertical Separator -->
                                <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,2" />

                                <!-- Custom Option -->
                                <Button x:Name="CustomOptionButton"
                                        Grid.Column="2"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,8"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <TextBlock Text="Custom" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CardButton 2: Review Session -->
                <Border x:Name="ReviewSessionCardButton"
                        Grid.Column="1"
                        Height="250"
                        CornerRadius="16"
                        BorderThickness="1.5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="24"
                        IsHitTestVisible="True">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0"
                                Width="54"
                                Height="54"
                                CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Center" Margin="0,14,0,10">
                            <TextBlock Text="Review Session"
                                       FontSize="21"
                                       FontWeight="Bold" />
                            <TextBlock Text="Practice and test active recall across your prepared questions and past sessions"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="Browse Sessions" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
