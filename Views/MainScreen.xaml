<Window
    x:Class="TableLamp.Views.MainScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TableLamp.Views"
    mc:Ignorable="d"
    Title="Table Lamp">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar in MainWindow / MainScreen -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="20,8,16,8">
            <Grid>
                <!-- Left: Branding -->
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE781;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Table Lamp" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                            CornerRadius="4" 
                            Padding="6,2" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1">
                        <TextBlock x:Name="MainScreenVersionTextBlock" Text="v0.0.8.0" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" 
                            CornerRadius="4" 
                            Padding="6,2">
                        <TextBlock Text="Basic" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Center: Navigation Elements (Icon-Only Buttons) Truly Centralized -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <!-- Dashboard Navigation Element -->
                    <Button x:Name="DashboardNavButton"
                            ToolTipService.ToolTip="Dashboard"
                            Style="{ThemeResource DefaultButtonStyle}"
                            Padding="12,8">
                        <FontIcon Glyph="&#xE80F;" FontSize="15" />
                    </Button>

                    <!-- Calendar Navigation Element -->
                    <Button x:Name="CalendarNavButton"
                            ToolTipService.ToolTip="Study Calendar"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="12,8">
                        <FontIcon Glyph="&#xE787;" FontSize="15" />
                    </Button>

                    <!-- Settings Navigation Element -->
                    <Button x:Name="SettingsNavButton"
                            ToolTipService.ToolTip="Settings"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="12,8">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </StackPanel>

                <!-- Right: Theme Switcher & Window Caption Controls -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            ToolTipService.ToolTip="Toggle Theme"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="8,6">
                        <FontIcon Glyph="&#xE706;" FontSize="14" />
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />
                    
                    <!-- Custom Minimize & Exit Buttons -->
                    <Button x:Name="WindowMinimizeButton"
                            ToolTipService.ToolTip="Minimize"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Width="40"
                            Height="30"
                            Padding="0">
                        <FontIcon Glyph="&#xE921;" FontSize="10" />
                    </Button>
                    <Button x:Name="WindowExitButton"
                            ToolTipService.ToolTip="Close"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Width="40"
                            Height="30"
                            Padding="0">
                        <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inner Content Frame for Pages -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- Floating Notification Card floating below App Name / Header on Left -->
        <local:FloatingNotificationCard x:Name="NotificationCard"
                                        Grid.Row="1"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="24,16,0,0"
                                        Canvas.ZIndex="1000" />
    </Grid>
</Window>
