<ContentDialog
    x:Class="TableLamp.Views.QuestionPopUp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Add Question"
    PrimaryButtonText="Add this Question"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <StackPanel Spacing="18" Width="480" Margin="0,8,0,0">
        <!-- Question Text Area -->
        <StackPanel Spacing="6">
            <TextBlock Text="Question Text" FontWeight="SemiBold" FontSize="14" />
            <TextBox x:Name="QuestionTextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="100"
                     MaxHeight="180"
                     PlaceholderText="Type the question content here..." />
        </StackPanel>

        <!-- Image Area -->
        <StackPanel Spacing="8">
            <TextBlock Text="Question Image (Optional)" FontWeight="SemiBold" FontSize="14" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImagePathBox"
                         Grid.Column="0"
                         PlaceholderText="Image URL or local file path..." />
                <Button x:Name="BrowseImageButton"
                        Grid.Column="1"
                        ToolTipService.ToolTip="Browse image file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                        <TextBlock Text="Browse" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Image Preview Card -->
            <Border x:Name="ImagePreviewContainer"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Image x:Name="PreviewImage"
                           Grid.Column="0"
                           MaxHeight="120"
                           Stretch="Uniform"
                           HorizontalAlignment="Left" />
                    <Button x:Name="RemoveImageButton"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Remove image">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Validation Error Message -->
        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   FontSize="12"
                   Text="Please enter text, select an image, or both." />
    </StackPanel>
</ContentDialog>
