<Page
    x:Class="TableLamp.Views.RecentSessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TableLamp.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="1000" MaxWidth="1000" HorizontalAlignment="Center" Spacing="24" Margin="32,24,32,48">
                <!-- Top Navigation & Header -->
                <StackPanel Spacing="10">
                    <Grid Margin="0,0,0,6">
                        <Button x:Name="BackButton"
                                AutomationProperties.AutomationId="RecentSession_BackButton"
                                Click="OnBackButtonClicked"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="8,6"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                <TextBlock Text="Back to Dashboard" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock AutomationProperties.AutomationId="RecentSession_HeaderTitle"
                               Text="Recent Sessions"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="Browse all study sessions chronologically grouped by the date they occurred."
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Filter Strip: DatePicker & Clear Filter Button -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE787;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Filter by Date:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>

                        <CalendarDatePicker x:Name="FilterDatePicker"
                                            AutomationProperties.AutomationId="RecentSession_DatePicker"
                                            Grid.Column="1"
                                            DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}"
                                            PlaceholderText="Select a date to filter (dd/mm/yyyy)..."
                                            DateChanged="OnFilterDateChanged"
                                            HorizontalAlignment="Stretch" />

                        <Button x:Name="ClearFilterButton"
                                AutomationProperties.AutomationId="RecentSession_ClearFilterButton"
                                Grid.Column="2"
                                Click="OnClearFilterClicked"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE894;" FontSize="13" />
                                <TextBlock Text="Show All Dates" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Empty State Message -->
                <Border x:Name="EmptyStateBorder"
                        AutomationProperties.AutomationId="RecentSession_EmptyStateBorder"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24,28"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE81C;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateText"
                                   AutomationProperties.AutomationId="RecentSession_EmptyStateText"
                                   Text="No sessions recorded yet."
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Date Grouped Sessions ItemsControl -->
                <ItemsControl x:Name="DateGroupsItemsControl"
                              AutomationProperties.AutomationId="RecentSession_DateGroupsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24" Spacing="10">
                                <!-- Date Header ("dd/mm/yyyy" format) -->
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,4">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding DateHeader}"
                                                   AutomationProperties.AutomationId="RecentSession_DateHeader"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SessionCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- Sessions List for this specific Date -->
                                <ItemsControl ItemsSource="{Binding Sessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="16,14"
                                                    Tapped="OnSessionCardTapped"
                                                    PointerEntered="OnSessionCardPointerEntered"
                                                    PointerExited="OnSessionCardPointerExited"
                                                    Tag="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Session Type Icon -->
                                                    <Border Grid.Column="0"
                                                            Width="38"
                                                            Height="38"
                                                            CornerRadius="8"
                                                            Background="{Binding SessionTypeIconBackground}"
                                                            Margin="0,0,14,0"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="{Binding SessionTypeTooltip}">
                                                        <FontIcon Glyph="{Binding SessionTypeGlyph}" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Session Metadata -->
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding FormattedDate}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding QuestionCount}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="questions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Right Action Arrow -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
