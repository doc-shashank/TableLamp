<Page
    x:Class="TableLamp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TableLamp.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="24" Margin="32,24,32,48">
                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />
                </StackPanel>

                <!-- Add Custom Presets Card (presetParser Engine) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Add Custom Presets" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="Add custom presets to the database" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="ViewStatisticsButton"
                                    AutomationProperties.AutomationId="Settings_ViewStatisticsButton"
                                    Click="OnViewStatisticsClicked"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="View Statistics" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Option A: Feed Multiple Files -->
                            <Border Grid.Column="0"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Import JSON Files" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Text="Select one or more JSON files from disk to parse and merge."
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="ImportJsonFilesButton"
                                            Content="Browse Files..."
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Padding="12,6" />
                                </StackPanel>
                            </Border>

                            <!-- Option B: Feed Whole Folder -->
                            <Border Grid.Column="1"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED43;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Import Folder" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Text="Recursively scans a directory for all .json files and feeds them in."
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="ImportFolderButton"
                                            Content="Browse Folder..."
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Padding="12,6" />
                                </StackPanel>
                            </Border>

                            <!-- Option C: Feed Compressed Archive (.zip) -->
                            <Border Grid.Column="2"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Import Archive (.zip)" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Text="Safely extracts a .zip archive and merges all .json presets into database."
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="ImportZipArchiveButton"
                                            Content="Browse .zip..."
                                            Style="{ThemeResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Padding="12,6" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Update Curated Presets Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Update Curated Presets" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="Sync with latest version of Curated Tags"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="UpdateCuratedPresetsButton"
                                    AutomationProperties.AutomationId="Settings_UpdateCuratedPresetsButton"
                                    Content="Check for Updates"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="True"
                                    Padding="16,8"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Floating Notification Settings Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Floating Notification Duration" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="Configure how long notification cards stay visible before auto-dismissing." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <ComboBox x:Name="NotificationDurationComboBox"
                                      AutomationProperties.AutomationId="Settings_NotificationDurationComboBox"
                                      Grid.Column="1"
                                      Width="160"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="3 seconds" Tag="3" />
                                <ComboBoxItem Content="5 seconds" Tag="5" />
                                <ComboBoxItem Content="7 seconds" Tag="7" />
                                <ComboBoxItem Content="10 seconds" Tag="10" />
                                <ComboBoxItem Content="15 seconds" Tag="15" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>



                <!-- Format Database / Maintenance Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SystemFillColorCriticalBrush}">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Database Management &amp; Formatting" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="Format the curated and custom tag databases separately to start completely afresh." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                            <Button x:Name="FormatCuratedDatabaseButton"
                                    AutomationProperties.AutomationId="Settings_FormatCuratedDatabaseButton"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="Format Curated Tags" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FormatCustomDatabaseButton"
                                    AutomationProperties.AutomationId="Settings_FormatCustomDatabaseButton"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="Format Custom Tags" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="FormatAllDatabasesButton"
                                    AutomationProperties.AutomationId="Settings_FormatAllDatabasesButton"
                                    Content="Format Both Databases"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="14,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Floating Notification Card floating at top of page on Left -->
        <local:FloatingNotificationCard x:Name="NotificationCard"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="24,16,0,0"
                                        Canvas.ZIndex="1000" />
    </Grid>
</Page>
