<Page
    x:Class="TableLamp.Views.EditCanvasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Bar -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="24,12,24,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="8,6"
                            ToolTipService.ToolTip="Back">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Back" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="Edit Session" FontSize="18" FontWeight="Bold" />
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="8,2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="QuestionCountBadge" Text="0 Questions" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Action Button: Save Session -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SaveSessionButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Padding="18,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save Session" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Split View (Left: Question Cards, Right: Stacked Preview Cards) -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*">
            <!-- Left Column: Question Cards List -->
            <Border Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid RowDefinitions="Auto,*">
                    <!-- Left Column Header with Add Button -->
                    <Border Grid.Row="0"
                            Padding="16,14,16,14"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Questions List" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="AddQuestionButton"
                                    Grid.Column="1"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="Add Question" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Question Cards Scrollable List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,14,14,24">
                        <StackPanel Spacing="10">
                            <!-- Empty State for Questions -->
                            <Border x:Name="LeftEmptyStateBorder"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="24"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE897;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Questions Yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click 'Add Question' above to create one."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Items Container -->
                            <ItemsControl x:Name="QuestionsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,10"
                                                IsHitTestVisible="True"
                                                Tapped="OnQuestionCardSelected"
                                                Tag="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Icon -->
                                                <Border Grid.Column="0"
                                                        Width="30"
                                                        Height="30"
                                                        CornerRadius="6"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE897;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Summary Text -->
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="Question Card" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Actions: Delete -->
                                                <Button Grid.Column="2"
                                                        ToolTipService.ToolTip="Delete Question"
                                                        Style="{ThemeResource SubtleButtonStyle}"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Padding="6"
                                                        Click="OnDeleteQuestionClicked"
                                                        Tag="{Binding}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Column: Stacked Text and Image PreviewCards -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,32">
                <StackPanel MaxWidth="800" Spacing="20">
                    <!-- Right Placeholder (When No Question Selected) -->
                    <Border x:Name="NoSelectionPlaceholder"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="48"
                            Margin="0,40,0,0">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8EC;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a Question" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Click any question card on the left to preview and edit its Text and Image components."
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Active Question Preview Container (Stacked: Text PreviewCard above Image PreviewCard) -->
                    <StackPanel x:Name="PreviewCardsContainer" Spacing="20" Visibility="Collapsed">
                        <!-- Preview Card 1: Text Preview Card -->
                        <Border x:Name="TextPreviewCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Text Preview" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="(Top Element)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Pencil Icon Button to edit text -->
                                    <Button x:Name="EditTextPencilButton"
                                            Grid.Column="1"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="8"
                                            ToolTipService.ToolTip="Edit Text Content">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Edit Text" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Text Preview Content -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinHeight="90"
                                        Padding="16">
                                    <TextBlock x:Name="TextPreviewContentBlock"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               LineHeight="22"
                                               Text="No text content." />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Preview Card 2: Image Preview Card -->
                        <Border x:Name="ImagePreviewCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Image Preview" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="(Bottom Element)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Pencil Icon Button to edit image -->
                                    <Button x:Name="EditImagePencilButton"
                                            Grid.Column="1"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="8"
                                            ToolTipService.ToolTip="Edit Image Content">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Edit Image" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Image Preview Content -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinHeight="140"
                                        Padding="16">
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock x:Name="NoImagePlaceholderText"
                                                   Text="No image attached. Click the pencil icon above to attach an image."
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image x:Name="ImagePreviewContentImage"
                                               MaxHeight="260"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
