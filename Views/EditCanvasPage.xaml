<Page
    x:Class="TableLamp.Views.EditCanvasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TableLamp.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Bar -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="28,14,28,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="8,6"
                            ToolTipService.ToolTip="Back">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Back" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="Edit Session" FontSize="18" FontWeight="Bold" />
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="8,2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="QuestionCountBadge" Text="0 Questions" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons: Add more Questions + Save Session -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="AddQuestionButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add more Questions" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveSessionButton"
                            Style="{ThemeResource DefaultButtonStyle}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save Session" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Question Cards List -->
        <ScrollViewer Grid.Row="1" Padding="32,24,32,48">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="16">
                <!-- Empty State -->
                <Border x:Name="EmptyStateBorder"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="40"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE897;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Questions Added Yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Click 'Add more Questions' to start creating questions for this session."
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="EmptyAddButton"
                                Content="Add more Questions"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Padding="20,8"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Questions Container -->
                <ItemsControl x:Name="QuestionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18,14">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Question Index / Icon -->
                                    <Border Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Question Content Preview -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Tag="{Binding}">
                                        <TextBlock Text="{Binding SummaryText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <TextBlock Text="Question Card" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions: Edit & Delete -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button ToolTipService.ToolTip="Edit Question"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Padding="8"
                                                Click="OnEditQuestionClicked"
                                                Tag="{Binding}">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        </Button>
                                        <Button ToolTipService.ToolTip="Delete Question"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Padding="8"
                                                Click="OnDeleteQuestionClicked"
                                                Tag="{Binding}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
