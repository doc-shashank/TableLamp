<Window
    x:Class="TableLamp.Views.DevToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TableLamp.Views"
    mc:Ignorable="d"
    Title="Table Lamp - Custom Presets Editor">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,*">
        <!-- Top Toolbar / Header -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="24,12,24,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Custom Presets Editor" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Dev Tools (v0.0.7.4)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Actions Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartFromScratchButton"
                            ToolTipService.ToolTip="Create new blank preset structure"
                            Style="{ThemeResource DefaultButtonStyle}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="Create new" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="LoadExampleButton"
                            ToolTipService.ToolTip="Load starter example preset data"
                            Style="{ThemeResource DefaultButtonStyle}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                            <TextBlock Text="Load example" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- File DropDown Menu -->
                    <DropDownButton x:Name="FileMenuButton"
                                    Content="File"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="16,6">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuNewWorkspace" Text="New Workspace">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED25;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuOpenWorkspace" Text="Open Workspace">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED43;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuOpenZipWorkspace" Text="Open Compressed Workspace (.zip)...">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE2;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuExportWorkspace" Text="Export Workspace">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuNewJsonFile" Text="New JSON File">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuOpenJsonFile" Text="Open JSON File">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuSaveJsonFile" Text="Save JSON File">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Rectangle Width="1" Height="20" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                    <!-- Custom Window Minimize & Exit Buttons -->
                    <Button x:Name="WindowMinimizeButton"
                            ToolTipService.ToolTip="Minimize"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Width="40"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE921;" FontSize="10" />
                    </Button>
                    <Button x:Name="WindowExitButton"
                            ToolTipService.ToolTip="Close"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Width="40"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Split View with Workspace Tree (optional), JSON Preview, and Contextual Editor -->
        <Grid Grid.Row="1" Margin="24,10,24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceColumnDef" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Card: Workspace Folder & File Tree (Visible when a workspace folder is open) -->
            <Border x:Name="WorkspaceCard"
                    Grid.Column="0"
                    Width="250"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="ContextNewJsonFile" Text="New JSON File">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C3;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ContextNewFolder" Text="New Folder">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8F7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="ContextRefreshWorkspace" Text="Refresh">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Workspace Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED43;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Workspace" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <!-- Original directory label opens folder on click (no floating pill) -->
                            <Grid x:Name="WorkspacePathContainer" Margin="0,2,0,0">
                                <TextBlock x:Name="WorkspacePathText"
                                           Text="C:\..."
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="Click to open folder in Explorer"
                                           IsHitTestVisible="True" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Workspace Tree View: Folders and Files with Expand / Collapse Hierarchy -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Enabled">
                        <StackPanel x:Name="WorkspaceTreeContainer" Spacing="2" HorizontalAlignment="Left" MinWidth="220" />
                    </ScrollViewer>

                    <Button x:Name="CloseWorkspaceButton"
                            Grid.Row="2"
                            Content="Close Workspace"
                            Style="{ThemeResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0"
                            Padding="8,4"
                            FontSize="11" />
                </Grid>
            </Border>

            <!-- 2. Center: JSON Preview Editor with Line Navigation & Active Line Highlight -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Top Bar: Preview Title, Mode Switch Button, and Navigation Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="13" />

                            <!-- Mode Switch Button beside Preview Header -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="SimplifiedModeButton"
                                            Content="Simplified"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11"
                                            CornerRadius="4" />
                                    <Button x:Name="JsonModeButton"
                                            Content="JSON"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11"
                                            CornerRadius="4" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="ActiveFileBadgeText" Text="(Unsaved File)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Next / Previous Element Navigation Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="PreviousElementButton"
                                    ToolTipService.ToolTip="Move to Previous Element (Subject / Chapter / Topic)"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72B;" FontSize="11" />
                                    <TextBlock Text="Previous" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NextElementButton"
                                    ToolTipService.ToolTip="Move to Next Element (Subject / Chapter / Topic)"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Next" FontSize="11" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Active Line Highlight Bar (JSON Mode Only) -->
                    <Border Grid.Row="1"
                            x:Name="ActiveLineIndicatorBorder"
                            Visibility="Collapsed"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2,0,0,0"
                            Padding="10,5"
                            CornerRadius="4"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock x:Name="ActiveLineGutterText" Text="Line 1:" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="ActiveLineContentSnippetText" Grid.Column="1" Text="{}{ ... }" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontFamily="Consolas, Cascadia Code, Courier New" />
                        </Grid>
                    </Border>

                    <!-- View Mode 1: Simplified Interactive Tree View -->
                    <ScrollViewer x:Name="SimplifiedTreeScrollViewer"
                                  Grid.Row="1"
                                  Grid.RowSpan="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SimplifiedTreeContainer" Spacing="4" Margin="4,4,4,16" />
                    </ScrollViewer>

                    <!-- View Mode 2: JSON Editor Textarea -->
                    <TextBox x:Name="JsonPreviewBox"
                             Grid.Row="2"
                             Visibility="Collapsed"
                             AcceptsReturn="True"
                             IsSpellCheckEnabled="False"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="12"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch" />

                    <!-- Empty State (When no workspace/file is open) -->
                    <StackPanel x:Name="EmptyDevToolsContainer"
                                Grid.Row="1"
                                Grid.RowSpan="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16"
                                Visibility="Collapsed">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED43;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Nothing in here" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Open or create new workspace" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button x:Name="EmptyOpenWorkspaceButton"
                                    Content="Open Workspace"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="14,8" />
                            <Button x:Name="EmptyCreateNewButton"
                                    Content="Create new"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="14,8" />
                            <Button x:Name="EmptyLoadExampleButton"
                                    Content="Load example"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="14,8" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Right: Contextual Line Editor Panel -->
            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Context Header with History Navigation Arrows (Back & Forward) -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Small back & forward arrows on the left of the label -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
                                    <Button x:Name="HistoryBackButton"
                                            ToolTipService.ToolTip="Go back to previously selected element"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="6,4">
                                        <FontIcon Glyph="&#xE72B;" FontSize="11" />
                                    </Button>
                                    <Button x:Name="HistoryForwardButton"
                                            ToolTipService.ToolTip="Go forward to next selected element"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            Padding="6,4">
                                        <FontIcon Glyph="&#xE72A;" FontSize="11" />
                                    </Button>
                                </StackPanel>

                                <!-- Context Title Label -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="ContextTitleText" Text="Selected: Subject Line" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock x:Name="ContextLineNumberText" Grid.Column="2" Text="Line 1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- A. SUBJECT LEVEL PANEL -->
                        <StackPanel x:Name="SubjectPanel" Spacing="12" Visibility="Visible">
                            <TextBlock Text="Subject Attributes" FontWeight="SemiBold" FontSize="18" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Subject Identifier" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,6">
                                    <TextBlock x:Name="SubjectIdentifierLabel" Text="Subject1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Short Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SubjectShortNameBox" PlaceholderText="e.g. Robins Physiology, Physics" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Full Name / Book Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SubjectFullNameBox" PlaceholderText="e.g. Robins Pathologic Basis of Disease" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Edition" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SubjectEditionBox" PlaceholderText="e.g. 7th" />
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                <Button x:Name="DeleteSubjectButton"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        ToolTipService.ToolTip="Delete this Subject"
                                        Padding="10,6"
                                        Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Delete" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="UpdateSubjectButton"
                                        Content="Apply Changes"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        Grid.Column="1"
                                        Margin="8,0"
                                        Width="140"
                                        HorizontalAlignment="Center" />

                                <Button x:Name="AddChapterButton"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="14,8"
                                        Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add New Chapter" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- B. CHAPTER LEVEL PANEL -->
                        <StackPanel x:Name="ChapterPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Chapter Attributes" FontWeight="SemiBold" FontSize="18" />

                            <!-- Clickable Parent Subject Label (Non-editable, navigates to subject on click) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Parent Subject (Click to navigate)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="ChapterParentSubjectButton"
                                        ToolTipService.ToolTip="Click to navigate to parent Subject"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="ChapterParentSubjectText" Text="Robins Physiology" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Chapter Identifier (Read-only, presented in a label) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Chapter Identifier" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,6">
                                    <TextBlock x:Name="ChapterIdentifierLabel" Text="Chapter1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Chapter Number (Integer only, serialized as chapter[x]) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Chapter Number (appends to JSON as 'chapter[x]')" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="ChapterNumberInput"
                                           SpinButtonPlacementMode="Compact"
                                           Minimum="1"
                                           SmallChange="1"
                                           Value="1" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Chapter Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="ChapterNameBox" PlaceholderText="e.g. Cell Injury, Inflammation" />
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                <Button x:Name="DeleteChapterButton"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        ToolTipService.ToolTip="Delete this Chapter"
                                        Padding="10,6"
                                        Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Delete" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="UpdateChapterButton"
                                        Content="Apply Changes"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        Grid.Column="1"
                                        Margin="8,0"
                                        Width="140"
                                        HorizontalAlignment="Center" />

                                <Button x:Name="AddTopicFromChapterButton"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="14,8"
                                        Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add New Topic" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- C. TOPIC LEVEL PANEL -->
                        <StackPanel x:Name="TopicPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Topic Attributes" FontWeight="SemiBold" FontSize="18" />

                            <!-- Clickable Parent Subject Label -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Parent Subject (Click to navigate)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="TopicParentSubjectButton"
                                        ToolTipService.ToolTip="Click to navigate to parent Subject"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE82D;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="TopicParentSubjectText" Text="Subject 1" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Clickable Parent Chapter Label -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Parent Chapter (Click to navigate)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="TopicParentChapterButton"
                                        ToolTipService.ToolTip="Click to navigate to parent Chapter"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="TopicParentChapterText" Text="Chapter 1" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Topic Identifier (presented in a label, not a text box) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Topic Identifier" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,6">
                                    <TextBlock x:Name="TopicIdentifierLabel" Text="Topic1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Topic Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="TopicNameBox" PlaceholderText="e.g. Causes of Cell Injury" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Start Page" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="TopicStartPageBox" PlaceholderText="e.g. 23" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="End Page" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="TopicEndPageBox" PlaceholderText="e.g. 27" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                <Button x:Name="DeleteTopicButton"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        ToolTipService.ToolTip="Delete this Topic"
                                        Padding="10,6"
                                        Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="Delete" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <!-- Apply changes moved next to Add topic -->
                                    <Button x:Name="UpdateTopicButton"
                                            Content="Apply Changes"
                                            Style="{ThemeResource DefaultButtonStyle}"
                                            Padding="14,8" />

                                    <!-- Retained Add Topic Button -->
                                    <Button x:Name="AddTopicButton"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="Add Topic" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- D. ROOT / GENERAL PANEL -->
                        <StackPanel x:Name="GeneralPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Preset Tree Overview" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="You are at the root level or outside active element tags." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button x:Name="AddSubjectButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="14,8"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add New Subject" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Floating Notification Card floating below Header on Left -->
        <local:FloatingNotificationCard x:Name="NotificationCard"
                                        Grid.Row="1"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="24,16,0,0"
                                        Canvas.ZIndex="1000" />
    </Grid>
</Window>
