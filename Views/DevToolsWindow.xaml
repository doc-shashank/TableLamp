<Window
    x:Class="TableLamp.Views.DevToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Table Lamp - Developer Tools &amp; Preset Tag Generator">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,Auto,*">
        <!-- Top Toolbar / Header -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="24,12,24,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Preset Tag Generator &amp; Tree Editor" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Dev Tools (v0.0.4)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Actions Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SaveToDatabaseButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                            <TextBlock Text="Save to Database" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="LoadStarterButton"
                            Style="{ThemeResource DefaultButtonStyle}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="Load Starter" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CopyJsonButton"
                            Style="{ThemeResource DefaultButtonStyle}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                            <TextBlock Text="Copy JSON" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportJsonButton"
                            Style="{ThemeResource DefaultButtonStyle}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock Text="Export File" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CloseButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                            <TextBlock Text="Close" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status InfoBar -->
        <InfoBar Grid.Row="1"
                 x:Name="StatusInfoBar"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="24,10,24,0" />

        <!-- Main Body: 2-Column Split (Left: JSON Preview with line tracking, Right: Contextual Editor) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,460" Margin="24,14,24,20" ColumnSpacing="18">
            <!-- Left Side: JSON Preview Textarea -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="JSON Preview" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="• Click or select any line below to edit its attributes on the right"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="JsonPreviewBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             IsSpellCheckEnabled="False"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="12"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <!-- Right Side: Contextual Line Editor Panel -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <!-- Context Header Badge -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="ContextTitleText" Text="Selected: Subject Line" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                                <TextBlock x:Name="ContextLineNumberText" Grid.Column="1" Text="Line 1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 1. SUBJECT LEVEL PANEL -->
                        <StackPanel x:Name="SubjectPanel" Spacing="14" Visibility="Visible">
                            <TextBlock Text="Subject Attributes" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Modify the short name, full name, and edition for this subject." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Subject Key / Identifier" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SubjectKeyBox" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Short Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SubjectShortNameBox" PlaceholderText="e.g. Robins Physiology, Physics" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Full Name / Book Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SubjectFullNameBox" PlaceholderText="e.g. Robins &amp; Cotran Pathologic Basis of Disease" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Edition" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SubjectEditionBox" PlaceholderText="e.g. 10th" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <Button x:Name="UpdateSubjectButton"
                                        Content="Apply Changes"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        Grid.Column="0" />

                                <Button x:Name="AddChapterButton"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="14,8"
                                        Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add New Chapter" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 2. CHAPTER LEVEL PANEL -->
                        <StackPanel x:Name="ChapterPanel" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Chapter Attributes" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Modify the chapter name or add new topics to this chapter." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Parent Subject" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="ChapterParentSubjectBox" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Chapter Identifier" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="ChapterKeyBox" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Chapter Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="ChapterNameBox" PlaceholderText="e.g. Cell Injury, Thermodynamics" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <Button x:Name="UpdateChapterButton"
                                        Content="Apply Changes"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        Grid.Column="0" />

                                <Button x:Name="AddTopicFromChapterButton"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="14,8"
                                        Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add New Topic" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 3. TOPIC LEVEL PANEL -->
                        <StackPanel x:Name="TopicPanel" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Topic Attributes" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Configure topic name, start page, and end page. The 'Add Topic' button is retained." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Parent Chapter" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="TopicParentChapterBox" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Topic Identifier" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="TopicKeyBox" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Topic Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="TopicNameBox" PlaceholderText="e.g. Causes of Cell Injury, Reversible Injury" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Start Page" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="TopicStartPageBox" PlaceholderText="e.g. 1" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="End Page" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="TopicEndPageBox" PlaceholderText="e.g. 12" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <Button x:Name="UpdateTopicButton"
                                        Content="Apply Changes"
                                        Style="{ThemeResource DefaultButtonStyle}"
                                        Grid.Column="0" />

                                <!-- Retained Add Topic Button -->
                                <Button x:Name="AddTopicButton"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="16,8"
                                        Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add Topic" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 4. ROOT / GENERAL PANEL -->
                        <StackPanel x:Name="GeneralPanel" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Preset Tree Root" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="You are at the root level of the preset database." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Button x:Name="AddSubjectButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="14,8"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add New Subject" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
