<Page
    x:Class="TableLamp.Views.SessionDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="24" Margin="32,24,32,48">
            <!-- Header -->
            <StackPanel Spacing="6">
                <Button x:Name="BackButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,6"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Back to Dashboard" FontSize="13" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Create a New Session" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Enter the session metadata to organize your study questions."
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Form Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28">
                <StackPanel Spacing="20">
                    <!-- Subject Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Subject" FontWeight="SemiBold" FontSize="14" />
                        <TextBox x:Name="SubjectBox" PlaceholderText="e.g. Physics, Chemistry, Biology" />
                    </StackPanel>

                    <!-- Chapter Number & Name Grid -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Chapter Number" FontWeight="SemiBold" FontSize="14" />
                            <NumberBox x:Name="ChapterNumberBox" Value="1" SpinButtonPlacementMode="Compact" Minimum="1" SmallChange="1" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Chapter Name" FontWeight="SemiBold" FontSize="14" />
                            <TextBox x:Name="ChapterNameBox" PlaceholderText="e.g. Thermodynamics, Kinematics" />
                        </StackPanel>
                    </Grid>

                    <!-- Toggleable Topic Name Field -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Specify Topic Name" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Optional: add fine-grained topic categorization"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="TopicToggle" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>

                            <TextBox x:Name="TopicNameBox"
                                     PlaceholderText="e.g. Carnot Cycle, Projectile Motion"
                                     Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <InfoBar x:Name="ValidationInfoBar"
                             IsOpen="False"
                             Severity="Warning"
                             Title="Required Fields"
                             Message="Please enter a Subject and Chapter Name before proceeding." />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Padding="20,10"
                                Grid.Column="0"
                                HorizontalAlignment="Left" />

                        <Button x:Name="NextButton"
                                Content="Next"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="32,10"
                                Grid.Column="1"
                                HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
