<Page
    x:Class="TableLamp.Views.SessionDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="24" Margin="32,24,32,48">
            <!-- Header -->
            <StackPanel Spacing="6">
                <Button x:Name="BackButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,6"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Back to Dashboard" FontSize="13" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Create a New Session" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Enter session metadata or use preset page search to auto-fill details."
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Form Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28">
                <StackPanel Spacing="20">
                    <!-- Preset Page Range Lookup Section (At top of Subject field) -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Preset Page Lookup" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="(Auto-Fill)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Start Page Numerical Field -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Start Page" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <NumberBox x:Name="StartPageBox"
                                               PlaceholderText="e.g. 23"
                                               SpinButtonPlacementMode="Compact"
                                               Minimum="1"
                                               SmallChange="1" />
                                </StackPanel>

                                <!-- End Page Numerical Field -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="End Page" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <NumberBox x:Name="EndPageBox"
                                               PlaceholderText="e.g. 27"
                                               SpinButtonPlacementMode="Compact"
                                               Minimum="1"
                                               SmallChange="1" />
                                </StackPanel>

                                <!-- Search Button -->
                                <Button x:Name="SearchPresetButton"
                                        Content="Search"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="20,8"
                                        VerticalAlignment="Bottom"
                                        Grid.Column="2" />
                            </Grid>

                            <!-- Multi-Match Guidance & Feedback InfoBar -->
                            <InfoBar x:Name="SearchFeedbackInfoBar"
                                     IsOpen="False"
                                     IsClosable="True" />
                        </StackPanel>
                    </Border>

                    <!-- Subject Field -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Subject" FontWeight="SemiBold" FontSize="14" />
                        <TextBox x:Name="SubjectBox" PlaceholderText="e.g. Robins Physiology, Chemistry, Biology" />
                    </StackPanel>

                    <!-- Chapter Number & Name Grid -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Chapter Number" FontWeight="SemiBold" FontSize="14" />
                            <NumberBox x:Name="ChapterNumberBox" Value="1" SpinButtonPlacementMode="Compact" Minimum="1" SmallChange="1" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Chapter Name" FontWeight="SemiBold" FontSize="14" />
                            <TextBox x:Name="ChapterNameBox" PlaceholderText="e.g. Cell Injury, Kinematics" />
                        </StackPanel>
                    </Grid>

                    <!-- Toggleable Topic Name Field -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Specify Topic Name" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Optional: add fine-grained topic categorization"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="TopicToggle" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>

                            <TextBox x:Name="TopicNameBox"
                                     PlaceholderText="e.g. Causes of Cell Injury, Projectile Motion"
                                     Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Book Name & Page Range Info Badge (Visible when preset loaded) -->
                    <Border x:Name="BookMetadataBadge"
                            Visibility="Collapsed"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE736;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="BookNameText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="PageRangeBadgeText" Grid.Column="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Validation Error Banner -->
                    <InfoBar x:Name="ValidationInfoBar"
                             IsOpen="False"
                             Severity="Warning"
                             Title="Required Fields"
                             Message="Please enter a Subject and Chapter Name before proceeding." />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Padding="20,10"
                                Grid.Column="0"
                                HorizontalAlignment="Left" />

                        <Button x:Name="NextButton"
                                Content="Next"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="32,10"
                                Grid.Column="1"
                                HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
