<Page
    x:Class="TableLamp.Views.SessionDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TableLamp.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="1200" MaxWidth="1200" HorizontalAlignment="Center" Spacing="24" Margin="32,24,32,48">
                <!-- Header with Session Mode Badge and Session Type Toggle on the Side -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <Button x:Name="BackButton"
                                AutomationProperties.AutomationId="SessionDetails_BackButton"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="8,6"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                <TextBlock Text="Back to Dashboard" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock AutomationProperties.AutomationId="SessionDetails_HeaderTitle" Text="Create a New Session" FontSize="26" FontWeight="Bold" />
                            <Border x:Name="HeaderModeBadgeBorder"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderModeBadgeText" AutomationProperties.AutomationId="SessionDetails_ModeBadgeText" Text="Curated" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="NewSessionHeaderSubtext"
                                   Text="Sessions created for self-study"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Session Type Toggle on Side of New Session Header (No text above switch) -->
                    <Border Grid.Column="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="SelfSessionButton"
                                    AutomationProperties.AutomationId="SessionDetails_SelfSessionButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="14,6"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE77B;" FontSize="12" />
                                    <TextBlock Text="Self" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClassSessionButton"
                                    AutomationProperties.AutomationId="SessionDetails_ClassSessionButton"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="14,6"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7BE;" FontSize="12" />
                                    <TextBlock Text="Class" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Form Card: ONLY contains Session Name, Subject Name, and Page Range -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="28">
                    <StackPanel Spacing="20">
                        <!-- 1. Mandatory Session Name Field -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Session Name" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="*" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="Bold" />
                            </StackPanel>
                            <TextBox x:Name="SessionNameBox" PlaceholderText="e.g. Morning Study - Cell Biology" />
                        </StackPanel>

                        <!-- 2. Subject Name Field (Above Page Range) with Closest Match Recommendation -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Subject Name" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="*" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="Bold" />
                                <Border x:Name="SubjectBadgeBorder"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SubjectStatusBadge" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBox x:Name="SubjectBox" PlaceholderText="e.g. Robins Physiology, Chemistry, Biology" />

                            <!-- Closest Match Recommendation Hint / Chip -->
                            <StackPanel x:Name="SubjectRecommendationPanel"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="Collapsed"
                                        Margin="2,2,0,0">
                                <TextBlock Text="Closest curated match:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <Button x:Name="SubjectRecommendationButton"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Padding="6,2"
                                        CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="SubjectRecommendationText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. Preset Page Range Lookup Section -->
                        <Border x:Name="PageRangeCard"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Page Range" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="PageRangeHintText" Text="(Enabled for Curated Subjects)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Start Page Numerical Field -->
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Start Page" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <NumberBox x:Name="StartPageBox"
                                                   PlaceholderText="e.g. 23"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="1"
                                                   SmallChange="1" />
                                    </StackPanel>

                                    <!-- End Page Numerical Field -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="End Page" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <NumberBox x:Name="EndPageBox"
                                                   PlaceholderText="e.g. 27"
                                                   SpinButtonPlacementMode="Compact"
                                                   Minimum="1"
                                                   SmallChange="1" />
                                    </StackPanel>

                                    <!-- Search Button -->
                                    <Button x:Name="SearchPresetButton"
                                            Content="Search"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Padding="20,8"
                                            VerticalAlignment="Bottom"
                                            Grid.Column="2" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Out of Card Container: Chapter & Topic Labels on Left, Action Buttons on Right -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="4,0,4,0">
                    <!-- Left: Chapter number, chapter name, and topic name fields as labels -->
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Assigned Chapters &amp; Topics" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Chapter:" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="70" />
                                    <TextBlock x:Name="ChapterLabelText" Grid.Column="1" Text="None" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Topic(s):" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="70" />
                                    <TextBlock x:Name="TopicLabelText" Grid.Column="1" Text="None" FontSize="13" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Name="MatchedSummaryBadgeText"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Cancel and Start Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                        <Button x:Name="CancelButton"
                                AutomationProperties.AutomationId="SessionDetails_CancelButton"
                                Content="Cancel"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Padding="20,10" />
                        <Button x:Name="NextButton"
                                AutomationProperties.AutomationId="SessionDetails_NextButton"
                                Content="Start"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="28,10" />
                    </StackPanel>
                </Grid>

                <!-- Warning/Information Card for Custom Tags Mode -->
                <Border x:Name="CustomTagInfoCard"
                        Visibility="Collapsed"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="4,0,4,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="CustomInfoTitleText" Text="Custom Tag Mode Active" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="CustomInfoSubtitleText"
                                       Text="Custom tag mode allows any subject name, but chapter and topic fields cannot be filled directly. Please update the App's database with custom tag JSONs via DevTools to assign preset chapters and topics."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button x:Name="OpenDevToolsButton"
                                Grid.Column="2"
                                Content="Open DevTools"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="14,8"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Floating Notification Card floating at top of page on Left -->
        <local:FloatingNotificationCard x:Name="NotificationCard"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="24,16,0,0"
                                        Canvas.ZIndex="1000" />
    </Grid>
</Page>
